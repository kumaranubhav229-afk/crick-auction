// Keep each format to 50 unique players from its five leading cricket nations.
// Players are interleaved by nation so the pool is not dominated by one country.
const TOP_NATIONS = {
  t20: ["IN","AU","EN","SA","PK"],
  odi: ["IN","AU","NZ","SA","PK"],
  test: ["AU","IN","EN","SA","NZ"]
};
for (const [format, pool] of Object.entries(POOLS)) {
  const byNation = Object.fromEntries(TOP_NATIONS[format].map(code => [code, []]));
  const seen = new Set();
  for (const entry of pool.players) {
    const [name, country] = entry.split("|");
    if (byNation[country] && !seen.has(name)) {
      byNation[country].push(entry);
      seen.add(name);
    }
  }
  const balanced = [];
  let index = 0;
  while (balanced.length < 50) {
    let added = false;
    for (const nation of TOP_NATIONS[format]) {
      if (byNation[nation][index]) {
        balanced.push(byNation[nation][index]);
        added = true;
        if (balanced.length === 50) break;
      }
    }
    if (!added) break;
    index++;
  }
  pool.players = balanced;
}

