function batRating(team){
  const rs=team.map(rating);
  return Math.round(rs.reduce((a,b)=>a+b,0)/rs.length + team.filter(p=>p.role==="Batter"||p.role==="WK-Batter").length*1.2 + team.filter(p=>p.role==="All-rounder").length*.5);
}
function bowlRating(team){
  const rs=team.map(rating);
  return Math.round(rs.reduce((a,b)=>a+b,0)/rs.length + team.filter(p=>p.role==="Bowler").length*1.5 + team.filter(p=>p.role==="All-rounder").length*.5);
}
function rand(min,max){return Math.random()*(max-min)+min;}
function pickWeighted(team, batting=true){
  const pool=team.filter(p=>batting?(p.role==="Batter"||p.role==="WK-Batter"||p.role==="All-rounder"):true);
  return pool[Math.floor(Math.random()*pool.length)] || team[0];
}
function makeBatting(team, bowlingTeam, target=null, mode="odi"){
  const maxRuns=mode==="t20"?220:mode==="test"?520:390;
  const base=mode==="t20"?145:mode==="test"?365:255;
  const advantage=(batRating(team)-bowlRating(bowlingTeam))*1.25;
  let score=Math.round(base+advantage+rand(-30,35));
  score=Math.max(mode==="t20"?95:mode==="test"?210:170,Math.min(maxRuns,score));
  let wickets=mode==="test"?Math.floor(rand(4,10)):Math.floor(rand(4,10));
  if(target!=null) score=Math.min(score,target+rand(-8,18));
  const bats=team.slice().sort(()=>Math.random()-0.5).slice(0,Math.min(6,team.length));
  let remaining=score;
  const batLines=bats.map((p,i)=>{
    let r=Math.round(remaining*(i===0?.22:i===1?.20:i===2?.17:i===3?.15:i===4?.13:.08)*rand(.75,1.25));
    r=Math.max(5,Math.min(remaining- (bats.length-i-1)*3,r));
    remaining-=r;
    return {name:p.name,runs:r,balls:Math.max(8,Math.round(r/rand(.55,.95)))};
  });
  if(remaining>0) batLines[batLines.length-1].runs+=remaining;
  const bowlers=bowlingTeam.filter(p=>p.role==="Bowler"||p.role==="All-rounder").slice().sort(()=>Math.random()-0.5).slice(0,5);
  const bowlLines=bowlers.map((p,i)=>{
    const wk=i===0?Math.max(1,Math.round(wickets*.28)):Math.max(0,Math.round(wickets*.18*rand(.5,1.5)));
    return {name:p.name,wickets:Math.min(4,wk),runs:Math.round((score/10)*rand(.65,1.0))};
  });
  return {score,wickets,batLines,bowlLines};
}
function simulatePairMatch(a,b,mode,stadium,dew,rain){
  const tossWinner=Math.random()<.5?a:b;
  const other=tossWinner.id===a.id?b:a;
  const decision=Math.random()<.5?"bat":"field";
  let first=tossWinner, second=other;
  if(decision==="field"){first=other;second=tossWinner;}
  const rainPenalty = rain==="heavy" ? 14 : rain==="light" ? 5 : 0;
  const dewBonus = dew==="high" ? 9 : dew==="low" ? 4 : 0;
  const minScore = mode==="t20" ? 95 : mode==="test" ? 210 : 170;
  const inn1=makeBatting(first.team,second.team,null,mode);
  inn1.score=Math.max(minScore,inn1.score-rainPenalty);
  const target=inn1.score+1;
  let inn2=makeBatting(second.team,first.team,target,mode);
  inn2.score=Math.max(minScore,inn2.score-rainPenalty+dewBonus);
  if(inn2.score>=target){
    inn2.score=target+Math.floor(rand(1,10));
    inn2.wickets=Math.max(2,Math.min(9,inn2.wickets-1));
  } else inn2.score=Math.min(inn2.score,target-1);
  const winner=inn2.score>=target?second:first;
  const margin=inn2.score>=target?`${10-inn2.wickets} wickets`:`${target-1-inn2.score} runs`;
  return {mode,stadium,dew,rain,teamA:{id:a.id,name:a.name,team:a.team},teamB:{id:b.id,name:b.name,team:b.team},
    tossWinner:tossWinner.id,decision,first:first.id,second:second.id,innings1:inn1,innings2:inn2,
    winner:winner.id,margin,createdAt:Date.now(),
    commentary:[`Venue: ${stadium}. Dew: ${dew}. Rain: ${rain}.`,`Toss: ${tossWinner.name} won the toss and chose to ${decision} first.`,
      `${first.name} posted ${inn1.score}/${inn1.wickets} in the first innings.`,`${second.name} began the chase with a target of ${target}.`,
      `${second.name} finished on ${inn2.score}/${inn2.wickets}.`,`${winner.name} won by ${margin}.`]};
}
function simulateMatch(){
  const us=users().filter(u=>u.team.length===TEAM_SIZE);
  if(us.length<2) return alert("You need two complete teams of 11 players to simulate a match.");
  if(state.match) return;
  const mode=state.mode, stadium=$("#matchStadium")?.value || STADIUMS[mode][0];
  const dew=$("#matchDew")?.value || "none", rain=$("#matchRain")?.value || "none";
  if(us.length===3){
    const fixtures=[[us[0],us[1]],[us[1],us[2]],[us[2],us[0]]];
    const matches=fixtures.map(([a,b])=>simulatePairMatch(a,b,mode,stadium,dew,rain));
    const table=us.map(u=>({id:u.id,name:u.name,played:0,wins:0,losses:0,points:0,runsFor:0,runsAgainst:0}));
    matches.forEach(m=>{
      const t1=table.find(t=>t.id===m.teamA.id), t2=table.find(t=>t.id===m.teamB.id);
      const score1=m.first===m.teamA.id?m.innings1.score:m.innings2.score;
      const score2=m.first===m.teamB.id?m.innings1.score:m.innings2.score;
      t1.played++;t2.played++;t1.runsFor+=score1;t1.runsAgainst+=score2;t2.runsFor+=score2;t2.runsAgainst+=score1;
      const win=table.find(t=>t.id===m.winner), lose=table.find(t=>t.id!==m.winner&& (t.id===m.teamA.id||t.id===m.teamB.id));
      win.wins++;win.points+=2;lose.losses++;
    });
    table.sort((x,y)=>y.points-x.points||(y.runsFor-y.runsAgainst)-(x.runsFor-x.runsAgainst)||y.wins-x.wins);
    const series={triSeries:true,mode,stadium,dew,rain,matches,table,champion:table[0].id,createdAt:Date.now()};
    patch({match:series,phase:"finished",log:addLog(`Tri-series simulated: ${table[0].name} finished top of the table.`)});
    return;
  }
  const match=simulatePairMatch(us[0],us[1],mode,stadium,dew,rain);
  match.commentary.push(`${users().find(u=>u.id===match.winner)?.name||"The winner"} looked stronger overall in this simulated ${POOLS[mode].label} matchup.`);
  patch({match,phase:"finished",log:addLog(`Imaginary match simulated: ${users().find(u=>u.id===match.winner)?.name||"Winner"} won by ${match.margin}.`)});
}
function teamStrength(team){
  return Math.round((batRating(team)+bowlRating(team))/2);
}
function renderMatch(){
  const m=state.match;
  if(!m) return "";
  if(m.triSeries){
    const scoreFor=(match,id)=>{const inn=match.first===id?match.innings1:match.innings2;return `${inn.score}/${inn.wickets}`;};
    return `<div class="match-card"><div class="match-head"><div><h2 style="margin:0">🏆 ${esc(POOLS[m.mode].label)} Tri-Series</h2><div class="sub">Three teams • three round-robin matches</div></div><span class="badge">SERIES COMPLETE</span></div>
      <div class="toss">🏟️ <b>Venue:</b> ${esc(m.stadium)}<br>💧 <b>Dew:</b> ${esc(m.dew)} • 🌧️ <b>Rain:</b> ${esc(m.rain)}</div>
      <h3>Points table</h3><div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;text-align:left"><thead><tr><th>Team</th><th>Played</th><th>Won</th><th>Lost</th><th>Points</th><th>Run diff.</th></tr></thead><tbody>${m.table.map((t,i)=>`<tr><td>${i===0?"🥇 ":""}${esc(t.name)}</td><td>${t.played}</td><td>${t.wins}</td><td>${t.losses}</td><td><b>${t.points}</b></td><td>${t.runsFor-t.runsAgainst>0?"+":""}${t.runsFor-t.runsAgainst}</td></tr>`).join("")}</tbody></table></div>
      <div class="result">🏆 Tri-Series Champion: ${esc(m.table[0].name)}</div><h3>Match results</h3>${m.matches.map((g,i)=>{const a=g.teamA,b=g.teamB,w=g.winner===a.id?a:b;return `<div class="verdict" style="margin-top:10px"><b>Match ${i+1}: ${esc(a.name)} vs ${esc(b.name)}</b><br>${esc(a.name)}: ${scoreFor(g,a.id)} &nbsp; • &nbsp; ${esc(b.name)}: ${scoreFor(g,b.id)}<br><b>${esc(w.name)} won by ${esc(g.margin)}</b><div class="muted">Toss: ${esc(g.tossWinner===a.id?a.name:b.name)} chose to ${esc(g.decision)} first.</div></div>`;}).join("")}</div>`;
  }
  const a=m.teamA,b=m.teamB;
  const score=(inn)=>`${inn.score}/${inn.wickets}`;
  const winner=state.users[m.winner]?.name || (m.winner===a.id?a.name:b.name);
  const verdictScoreA=teamStrength(a.team), verdictScoreB=teamStrength(b.team);
  const verdict=verdictScoreA===verdictScoreB
    ? "Very even matchup — the toss and execution would likely decide it."
    : `${verdictScoreA>verdictScoreB?a.name:b.name} is the stronger XI on paper, with the better combined batting/bowling balance.`;
  const lines=Object.entries(state.users||{}).map(([id,u])=>({id,...u})).filter(u=>u.id===a.id||u.id===b.id);
  return `<div class="match-card">
    <div class="match-head"><div><h2 style="margin:0">🏟️ Imaginary ${esc(POOLS[m.mode].label)} Match</h2><div class="sub">Playing XI confirmed • simulated result</div></div>
    <span class="badge">MATCH COMPLETE</span></div>
    <div class="toss">🏟️ <b>Venue:</b> ${esc(m.stadium||"Not specified")}<br>💧 <b>Dew:</b> ${esc(m.dew||"none")} • 🌧️ <b>Rain:</b> ${esc(m.rain||"none")}<br>🪙 <b>Toss:</b> ${esc(state.users[m.tossWinner]?.name||"Winner")} won the toss and chose to <b>${esc(m.decision)}</b> first.</div>
    <div class="score-grid">
      <div class="score-box"><b>${esc(a.name)}</b><div class="score">${score(m.first===a.id?m.innings1:m.innings2)}</div><div class="muted">${m.first===a.id?"1st innings":"2nd innings"}</div></div>
      <div class="score-box"><b>${esc(b.name)}</b><div class="score">${score(m.first===b.id?m.innings1:m.innings2)}</div><div class="muted">${m.first===b.id?"1st innings":"2nd innings"}</div></div>
    </div>
    <div class="result">🏆 ${esc(winner)} won by ${esc(m.margin)}</div>
    <div class="verdict"><b>VERDICT</b><br>${esc(verdict)}<br><span class="muted">Paper strength: ${esc(a.name)} ${verdictScoreA} • ${esc(b.name)} ${verdictScoreB}</span></div>
    <details open><summary>Playing XIs</summary>
      <div class="score-grid"><div><b>${esc(a.name)}</b><div class="xi">${a.team.map(p=>`<span>${esc(p.name)}</span>`).join("")}</div></div>
      <div><b>${esc(b.name)}</b><div class="xi">${b.team.map(p=>`<span>${esc(p.name)}</span>`).join("")}</div></div></div>
    </details>
    <details open><summary>Key batting & bowling</summary>
      <div class="score-grid">
        <div><b>${esc(state.users[m.first===a.id?a.id:b.id]?.name||"Team A")} innings</b>
          <div class="muted" style="margin-top:8px">${(m.first===a.id?m.innings1:m.innings2).batLines.map(x=>`${esc(x.name)} ${x.runs} (${x.balls})`).join(" • ")}</div>
          <div class="muted" style="margin-top:8px">${(m.first===a.id?m.innings1:m.innings2).bowlLines.map(x=>`${esc(x.name)} ${x.wickets}/${x.runs}`).join(" • ")}</div>
        </div>
        <div><b>${esc(state.users[m.first===b.id?b.id:a.id]?.name||"Team B")} innings</b>
          <div class="muted" style="margin-top:8px">${(m.first===b.id?m.innings1:m.innings2).batLines.map(x=>`${esc(x.name)} ${x.runs} (${x.balls})`).join(" • ")}</div>
          <div class="muted" style="margin-top:8px">${(m.first===b.id?m.innings1:m.innings2).bowlLines.map(x=>`${esc(x.name)} ${x.wickets}/${x.runs}`).join(" • ")}</div>
        </div>
      </div>
    </details>
    <details><summary>Match commentary</summary><div class="commentary">${m.commentary.map((x,i)=>`<div>${i+1}. ${esc(x)}</div>`).join("")}</div></details>
  </div>`;
}

/* ---------- rendering ---------- */
function renderGame(){
  const us=users(), isHost=state.host===uid, a=state.auction, M=POOLS[state.mode];
  const players=Object.values(state.players||{});
  const order={available:0,unsold:1,sold:2,vetoed:3};
  $("#app").innerHTML=`<div class="top">
    <div><h1>🏏 Cricket Auction <span class="badge">${esc(M.label)}</span></h1><div class="sub">Room <b>${esc(roomId)}</b> • ${state.phase==="lobby"?"Waiting room":state.phase==="finished"?"Auction complete":"Live auction"} • ${state.startPoints} pts each</div></div>
    <div class="row"><button class="ghost" id="copy">Copy invite link</button>${isHost?`<button class="danger" id="reset">Reset room</button>`:""}</div>
  </div>
  <div class="grid">
    <div>
      <div class="card">${state.phase==="lobby"?renderLobbyPanel(us,isHost):state.phase==="finished"?renderFinished(isHost):renderAuction(a,us)}</div>
      ${state.phase!=="lobby"?renderTeams(us):""}
    </div>
    <div>
      <div class="card">
        <h3 style="margin-top:0">Players</h3>
        <div class="stats">${us.map(u=>`<div class="stat"><span class="muted">${esc(u.name)}${u.id===state.host?" 👑":""}</span><b>${u.points} pts</b><span class="muted">${u.team.length}/${TEAM_SIZE} • ${u.skips} vetoes</span></div>`).join("")}</div>
        <h3 style="margin:14px 0 0">${esc(M.label)} pool (${players.length})</h3>
        <div class="players">${players.slice().sort((x,y)=>order[x.status]-order[y.status]).map(p=>`<div class="player" style="opacity:${p.status==="available"?1:.45}"><h3>${p.flag} ${esc(p.name)}</h3><span class="tag">${esc(p.country)}</span><span class="tag">${esc(p.role)}</span><div class="muted" style="font-size:11px;margin-top:5px">${p.status==="available"?"Available":p.status==="sold"?"Sold":p.status==="unsold"?"Unsold":"Vetoed"}</div></div>`).join("")}</div>
      </div>
      <div class="card" style="margin-top:18px"><h3 style="margin-top:0">Auction log</h3><div class="log">${logs().slice().reverse().map(x=>`<div><span class="muted">${new Date(x.t).toLocaleTimeString()}</span> — ${esc(x.m)}</div>`).join("")}</div></div>
    </div>
  </div>
  <div class="footer">${esc(M.label)} • 2–3 players • ${state.startPoints} points • ${VETOES} vetoes • ${TEAM_SIZE}-player teams • min price 1</div>`;

  $("#copy").onclick=()=>navigator.clipboard.writeText(inviteLink()).then(()=>alert("Invite link copied. Send it to your friends!"),()=>prompt("Copy this link:",inviteLink()));
  if(isHost) $("#reset").onclick=resetRoom;
  const s=$("#start"); if(s) s.onclick=startAuction;
  document.querySelectorAll("[data-inc]").forEach(b=>b.onclick=()=>doBid(+b.dataset.inc));
  const p=$("#pass"); if(p) p.onclick=doPass;
  const v=$("#veto"); if(v) v.onclick=doVeto;
  const sm=$("#simulateMatch"); if(sm) sm.onclick=simulateMatch;
  const l=$("#leave"); if(l) l.onclick=()=>{if(unsub)unsub();unsub=null;state=null;roomId=null;location.hash="";renderLobby();};
}
function renderLobbyPanel(us,isHost){
  const M=POOLS[state.mode];
  return `<div class="center"><h2>Waiting for players</h2>
    <div class="room-code">${esc(roomId)}</div><div class="share">Share the invite link (button above) with your friends.</div>
    <div class="notice" style="margin-top:12px">${esc(M.label)} mode • ${state.startPoints} points each • ${M.players.length} players in the pool</div>
    <div class="stats">${us.map(u=>`<div class="stat"><span class="muted">${esc(u.name)}</span><b>Ready</b></div>`).join("")}</div>
    ${us.length<2?`<div class="notice">At least 2 players are required. A maximum of 3 can join.</div>`:`<div class="notice good-note">${us.length} players connected. ${isHost?"You can start the auction.":"Waiting for the host to start."}</div>`}
    ${isHost?`<button class="primary" id="start" ${us.length<2?"disabled":""} style="margin-top:15px">Start auction</button>`:""}
  </div>`;
}
function renderFinished(isHost){
  const complete=users().filter(u=>u.team.length===TEAM_SIZE);
  const already=!!state.match;
  return `<div class="center auction"><div style="font-size:42px">${already?"🏆":"🏏"}</div>
    <h2>${already?"Match complete":"Auction complete"}</h2>
    <div class="muted">${complete.length>=3?"All three playing XIs are confirmed — a round-robin tri-series will be played.":complete.length===2?"Both playing XIs are confirmed.":"Complete at least two teams first."}</div>
    ${!already&&isHost&&complete.length>=2?`
      <div style="max-width:460px;width:100%;margin:14px auto;text-align:left">
        <label class="muted">Stadium (${esc(POOLS[state.mode].label)})</label>
        <select id="matchStadium" style="width:100%;margin-top:5px">${STADIUMS[state.mode].map(v=>`<option>${esc(v)}</option>`).join("")}</select>
        <div class="row" style="margin-top:10px">
          <div style="flex:1"><label class="muted">Dew</label><select id="matchDew" style="width:100%;margin-top:5px"><option value="none">No dew</option><option value="low">Low dew</option><option value="high">Heavy dew</option></select></div>
          <div style="flex:1"><label class="muted">Rain</label><select id="matchRain" style="width:100%;margin-top:5px"><option value="none">No rain</option><option value="light">Light rain</option><option value="heavy">Heavy rain</option></select></div>
        </div>
      </div>
      <div class="controls"><button class="gold" id="simulateMatch">${complete.length===3?"🏆 Simulate Tri-Series (3 matches)":"🪙 Toss &amp; Simulate Match"}</button></div>`:""}
    ${already?`<div class="notice good-note" style="margin-top:12px">The imaginary match has been simulated and saved for everyone in the room.</div>`:""}
    <div class="controls">${isHost?`<span class="muted">Use “Reset room” to play again.</span>`:""}<button class="ghost" id="leave">Leave room</button></div>
  </div>${already?renderMatch():""}`;
}
function renderAuction(a,us){
  if(!a) return `<div class="auction"><h2>Preparing auction…</h2></div>`;
  const p=state.players[a.playerKey], myTurn=a.turn===uid, mu=us.find(u=>u.id===uid), mb=maxBid(mu);
  const cur=a.turn?uname(a.turn):"…";
  const btn=inc=>{const nb=a.currentBid+inc;return `<button class="${inc===1?"primary":"gold"}" data-inc="${inc}" ${myTurn&&nb<=mb?"":"disabled"}>Bid ${nb}${inc>1?` (+${inc})`:""}</button>`};
  return `<div class="auction">
    <div class="muted">CURRENT PLAYER</div>
    <div class="name">${p.flag} ${esc(p.name)}</div>
    <div class="role">${esc(p.country)} • ${esc(p.role)}</div>
    <div class="bid">${a.currentBid}</div>
    <div class="muted">points • ${a.highestBidder?`highest bidder: <b>${esc(uname(a.highestBidder))}</b>`:"no bid yet"}</div>
    <div class="turn">${myTurn?"YOUR TURN":"Waiting for "+esc(cur)+"…"}</div>
    <div class="controls">${btn(1)}${btn(2)}${btn(5)}
      <button class="ghost" id="pass" ${myTurn&& (a.started||uid!==a.openingTurn)?"":"disabled"}>Pass</button>
      <button class="danger" id="veto" ${myTurn&&me.skips>0?"":"disabled"}>Veto player (${me.skips})</button></div>
    <div class="muted" style="margin-top:10px;font-size:12px">${!a.started&&uid===a.openingTurn?"Opening bidder: you must bid or veto; passing is locked. ":"A veto is available on your turn, even after bidding has started. "}Your max bid right now: <b>${Math.max(0,mb)}</b> (1 point is reserved for each empty slot in your XI). Bidding rotates; when everyone else passes, the highest bidder wins. If all pass with no bid, the player goes unsold and returns once at the end.</div>
  </div>`;
}
function renderTeams(us){
  return `<div class="card team"><div class="team-head"><h3 style="margin:0">Teams</h3><span class="muted">Target: ${TEAM_SIZE} players</span></div>
    ${us.map(u=>`<div style="margin-top:12px"><b>${esc(u.name)}</b> <span class="muted">(${u.points} points left • ${u.team.length}/${TEAM_SIZE})</span>
      <div class="team-list">${u.team.map(x=>`<span class="chip">${esc(x.name)} <span class="muted">${esc(x.role)}</span> — ${x.price}</span>`).join("")||`<span class="muted">No players yet</span>`}</div></div>`).join("")}</div>`;
}

