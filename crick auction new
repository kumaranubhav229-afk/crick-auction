const isReal = c => c && c.apiKey && c.databaseURL && !String(c.apiKey).startsWith("PASTE_") && !String(c.databaseURL).includes("PASTE_");
function parseConfig(text){
  let t=text.replace(/\/\*[\s\S]*?\*\//g,"").replace(/^\s*\/\/.*$/gm,"");
  const k=t.search(/["']?apiKey["']?\s*:/);
  if(k<0) return null;
  const a=t.lastIndexOf("{",k), b=t.indexOf("}",k);
  if(a<0||b<a) return null;
  t=t.slice(a,b+1);
  let c=null;
  try{ c=JSON.parse(t); }catch(e){
    try{ c=JSON.parse(t.replace(/'/g,'"').replace(/([{,]\s*)([A-Za-z_]\w*)\s*:/g,'$1"$2":').replace(/,\s*}/g,"}")); }catch(e2){ return null; }
  }
  // Firebase omits databaseURL until a Realtime Database exists; guess the default (US) one.
  if(c && c.apiKey && !c.databaseURL && c.projectId) c.databaseURL=`https://${c.projectId}-default-rtdb.firebaseio.com`;
  return c;
}
function loadConfig(){
  if(isReal(FIREBASE_CONFIG)) return {cfg:FIREBASE_CONFIG, src:"embedded"};
