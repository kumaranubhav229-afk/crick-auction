/* ---------- state helpers ---------- */
const logs=()=>{const l=state.log||[];return Array.isArray(l)?l:Object.values(l)};
const addLog=m=>[...logs(),{t:Date.now(),m}].slice(-60);
const patch=obj=>update(ref(db,"rooms/"+roomId),obj);
const users=()=>Object.entries(state.users||{}).map(([id,u])=>({id,...u,team:u.team||[]})).sort((a,b)=>(a.joinedAt||0)-(b.joinedAt||0));
const full=u=>u.team.length>=TEAM_SIZE;
const maxBid=u=>u.points-(TEAM_SIZE-u.team.length-1);   // keep 1 pt for every other empty slot
const uname=id=>state.users?.[id]?.name||"Player";

function nextTurn(fromId,highest,bid,passes,us=users()){
  const i=us.findIndex(u=>u.id===fromId);
  for(let k=1;k<=us.length;k++){
    const u=us[(i+k)%us.length];
    if(u.id!==highest && !passes[u.id] && !full(u) && maxBid(u)>bid) return u.id;
  }
  return null;
}
function firstTurn(pref,us){
  const i=Math.max(0,us.findIndex(u=>u.id===pref));
  for(let k=0;k<us.length;k++){const u=us[(i+k)%us.length]; if(!full(u)) return u.id;}
  return null;
}
// Fills `up` with the next nomination (or finish) based on a working copy of players/users.
function advance(up,pl,us,prefTurn){
  const avail=()=>Object.keys(pl).filter(k=>pl[k].status==="available");
  if(us.every(full)){ up.phase="finished"; up.auction=null; return up; }
  let keys=avail();
  if(!keys.length && !state.requeued){
    const un=Object.keys(pl).filter(k=>pl[k].status==="unsold");
    if(un.length){ un.forEach(k=>{pl[k].status="available";up[`players/${k}/status`]="available";}); up.requeued=true; keys=avail(); }
  }
  if(!keys.length){ up.phase="finished"; up.auction=null; return up; }
  // `prefTurn` is the player who opens this nomination. The opening bidder
  // is deliberately independent of who won the previous player. This makes
  // the auction rotate A -> B -> C -> A for successive nominations.
  up.auction={playerKey:keys[Math.floor(Math.random()*keys.length)],started:false,currentBid:0,turn:firstTurn(prefTurn,us),openingTurn:firstTurn(prefTurn,us),passes:null};
  return up;
}

/* ---------- actions ---------- */
async function startAuction(){
  const up={phase:"auction"};
  advance(up,clone(state.players),users(),state.host);
  up.log=addLog(`${uname(state.host)} starts the ${POOLS[state.mode].label} auction.`);
  await patch(up);
}
async function settle(a,winnerId,passes){
  const up={}, pl=clone(state.players), us=users(), p=pl[a.playerKey];
  let msg, pref;
  if(winnerId){
    const w=us.find(u=>u.id===winnerId);
    w.team=[...w.team,{name:p.name,country:p.country,role:p.role,price:a.currentBid}]; w.points-=a.currentBid;
    up[`users/${winnerId}/points`]=w.points; up[`users/${winnerId}/team`]=w.team;
    p.status="sold"; up[`players/${a.playerKey}/status`]="sold"; up[`players/${a.playerKey}/owner`]=winnerId;
    msg=`${w.name} bought ${p.name} for ${a.currentBid} points.`;
    // Next player nomination starts with the next participant, not the winner.
    const oi=us.findIndex(u=>u.id===a.openingTurn);
    pref=us.length ? us[(oi+1+us.length)%us.length].id : winnerId;
  } else {
    p.status="unsold"; up[`players/${a.playerKey}/status`]="unsold";
    msg=`${p.name} went unsold.`;
    const oi=us.findIndex(u=>u.id===a.openingTurn);
    pref=us.length ? us[(oi+1+us.length)%us.length].id : a.openingTurn;
  }
  advance(up,pl,us,pref);
  up.log=addLog(msg);
  await patch(up);
}
async function doBid(inc){
  const a=state.auction; if(!a||a.turn!==uid) return;
  const mu=users().find(u=>u.id===uid), nb=a.currentBid+inc;
  if(nb>maxBid(mu)) return alert("That bid is above your limit (you must keep 1 point for each empty team slot).");
  const next=nextTurn(uid,uid,nb,{});
  const na={...a,started:true,currentBid:nb,highestBidder:uid,passes:null,turn:next||uid};
  if(!next){ // nobody else can outbid -> sold
    await settle(na,uid,{}); return;
  }
  await patch({auction:na,log:addLog(`${me.name} bid ${nb} for ${state.players[a.playerKey].name}.`)});
}
async function doPass(){
  const a=state.auction; if(!a||a.turn!==uid) return;
  // The player who opens a nomination must make the first bid or veto; no opening pass.
  if(!a.started && uid===a.openingTurn) return alert("The opening bidder must bid or use a veto before passing.");
  const passes={...(a.passes||{}),[uid]:true}, us=users();
  const pending=us.filter(u=>u.id!==a.highestBidder && !full(u) && !passes[u.id] && maxBid(u)>a.currentBid);
  if(!pending.length) return settle(a,a.highestBidder||null,passes);
  const next=nextTurn(uid,a.highestBidder||null,a.currentBid,passes,us);
  await patch({auction:{...a,passes,turn:next},log:addLog(`${me.name} passed.`)});
}
async function doVeto(){
  const a=state.auction; if(!a||a.turn!==uid||me.skips<=0) return;
  // A veto can be used on your turn before or after the first bid; it cancels this nomination.
  const up={}, pl=clone(state.players), us=users(), p=pl[a.playerKey];
  p.status="vetoed"; up[`players/${a.playerKey}/status`]="vetoed";
  up[`users/${uid}/skips`]=me.skips-1;
  advance(up,pl,us,a.turn);
  up.log=addLog(`${me.name} used a veto and removed ${p.name} from the pool.`);
  await patch(up);
}
async function resetRoom(){
  if(!confirm("Reset the room back to the lobby? All teams and points will be reset.")) return;
  const up={phase:"lobby",auction:null,requeued:null,match:null,players:buildPlayers(state.mode),log:[{t:Date.now(),m:"Room was reset by the host."}]};
  users().forEach(u=>{up[`users/${u.id}/points`]=state.startPoints;up[`users/${u.id}/skips`]=VETOES;up[`users/${u.id}/team`]=null;});
  await patch(up);
}


